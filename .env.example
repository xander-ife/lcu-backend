# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lcu_timetable?schema=public"

# JWT
JWT_SECRET="change_this_to_a_long_random_string_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# CORS - your frontend URL (Vite default is 5173)
CLIENT_URL="http://localhost:5173"
